{
  "name": "styler",
  "version": "4.1.1",
  "author": "Folke Lemaitre",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "check": "tsc",
    "test": "pnpm build && node --test tests/*.test.mjs",
    "test:browser": "pnpm build && node tests/browser.mjs",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "pnpm run lint --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "lit": "3.3.3",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22.12.0"
  }
}
